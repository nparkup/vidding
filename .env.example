# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding 키). 비워두면 목업 데이터로 동작합니다.
DATA_GO_KR_SERVICE_KEY=

# 관리자 페이지 비밀번호 (반드시 변경하세요)
ADMIN_PASSWORD=change-me
# 관리자 세션 쿠키 서명용 임의 문자열
ADMIN_SESSION_SECRET=replace-with-long-random-string

# 사이트 주소 (메일 속 링크에 사용)
SITE_URL=http://localhost:3000

# PostgreSQL 접속 주소. 비워두면 data/runtime-db.json 파일에 저장합니다.
DATABASE_URL=
# 데모 고객사·상담 데이터 자동 입력 (운영에서는 false)
SEED_DEMO=true

# 메일 발송 (SMTP). 비워두면 발송 없이 기록만 남깁니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="입찰메이트랩 <daily@example.com>"

# 스케줄러 호출 인증 (Authorization: Bearer <값>)
CRON_SECRET=
